{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "builtin-baseline": "f33cc491c85a7d643c5ab6da1667c1458e6d7abf",
  "name": "asymptote",
  "version": "0.0-snapshot",
  "dependencies": [
    "zlib",
    "glm",
    "vulkan",
    "vulkan-sdk-components",
    "glfw3",
    "glslang",
    {
      "name": "getopt-win32",
      "platform": "windows"
    }
  ],
  "$comment-overrides": "getopt-win32 1.1.0.20220925 (the version at builtin-baseline) fetches a now-deleted commit from xiaozhuai/getopt-win32 and 404s; 2.42.0 points at the maintained ludvikjerabek/getopt-win fork. Requires a vcpkg checkout recent enough to know version 2.42.0.",
  "overrides": [
    {
      "name": "getopt-win32",
      "version": "2.42.0"
    }
  ],
  "features": {
    "threading": {
      "description": "Enable threading support",
      "dependencies": [
        "pthreads"
      ]
    },
    "readline": {
      "description": "Enable readline support",
      "dependencies": [
        "readline",
        {
          "name": "ncurses",
          "platform": "!windows"
        },
        {
          "name": "pdcurses",
          "platform": "windows"
        }
      ]
    },
    "curl": {
      "description": "Enable curl support",
      "dependencies": [
        "curl"
      ]
    },
    "eigen3": {
      "description": "eigen3 support",
      "dependencies": [
        "eigen3"
      ]
    },
    "gsl": {
      "description": "GSL support",
      "dependencies": [
        "gsl"
      ]
    },
    "fftw3": {
      "description": "fftw3 support",
      "dependencies": [
        "fftw3"
      ]
    },
    "lsp": {
      "description": "Language Server Protocol Support",
      "dependencies": [
        "rapidjson",
        "asio",
        "ixwebsocket"
      ]
    }
  }
}
