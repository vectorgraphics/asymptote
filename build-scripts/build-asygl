#!/usr/bin/env bash

die() {
  printf '%s\n' "$*" >&2
  exit 1
}

showUsage() {
  echo Usage: "$0 [debug|debug-source-map]"
  exit 1
}

if [ $# -gt 1 ]; then
    showUsage
fi

if [ $# = 1 ]; then
  if [ "$1" != "debug" ] && [ "$1" != "debug-source-map" ]; then
    showUsage
  fi
fi

npm ci --prefix webgl

(cd webgl && npx tsc --noEmit) || die "TypeScript type checking failed"

ASYGL_OUTPUT=base/webgl/asygl.js

ESBUILD_ARGS="src/gl.ts --bundle --format=iife --target=es2017 --loader:.glsl=text"

if [ "$1" = "debug" ]; then
  ESBUILD_ARGS="$ESBUILD_ARGS --sourcemap=external"
elif [ "$1" = "debug-source-map" ]; then
  ESBUILD_ARGS="$ESBUILD_ARGS --sourcemap=inline"
else
  ESBUILD_ARGS="$ESBUILD_ARGS --minify"
fi

{
  cat webgl/license
  echo ""
  echo "/* license for gl-matrix: "
  curl -sL https://cdn.jsdelivr.net/gh/toji/gl-matrix@refs/heads/master/LICENSE.md
  echo "*/"
} > "$ASYGL_OUTPUT"

TMPJS=$(mktemp)
(cd webgl && npx esbuild $ESBUILD_ARGS --outfile="$TMPJS")
cat "$TMPJS" >> "$ASYGL_OUTPUT"
rm -f "$TMPJS"
